  missionId: CTU_00_RECON
  title: CAMPUS RECON
  briefing: Regroup at Gate B, survey the administration building, then locate the
    Learning Resource Centre uplink.
  completionText: Route surveyed. Regroup or explore the campus.
  levelId: 2
  objectives:
  - id: RECON_GATE_B
    title: REGROUP AT GATE B
    instruction: Everyone alive inside the cyan ring.
    center: {x: 0, y: 0, z: -40}
    radius: 6
    heightTolerance: 2.5
    holdSeconds: 2
  - id: RECON_ADMIN
    title: REACH THE ADMINISTRATION BUILDING
    instruction: Everyone alive inside the cyan ring.
    center: {x: 32, y: 0, z: -21}
    radius: 6
    heightTolerance: 2.5
    holdSeconds: 2
  - id: RECON_LIBRARY
